# Copy to .env for local development.  Nothing here is a secret: the real values are
# written into the Lambda's environment by the CDK stack in infra/.

# ---- server -----------------------------------------------------------------------------
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
# Unset means "allow any origin", which is fine locally and wrong in production.
CORS_ORIGINS=http://localhost:5173

# ---- auth -------------------------------------------------------------------------------
# Local development only.  Every request is treated as a signed-in user, and the Cognito
# variables below are not needed.  Ignored when NODE_ENV=production.
AUTH_BYPASS=true

# From the Cognito user pool the CDK stack creates.  Required unless AUTH_BYPASS is on.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ---- dynamodb ---------------------------------------------------------------------------
AWS_REGION=eu-central-1

# Table names are generated by CDK, so they are never hard-coded in the source.
# Expected key schemas:
#   TABLE_PROGRESS   partition userId (S),  sort topicId   (S)
#   TABLE_REQUESTS   partition topic  (S),  sort userId    (S)
#   TABLE_FEEDBACK   partition userId (S),  sort createdAt (S)
TABLE_PROGRESS=
TABLE_REQUESTS=
TABLE_FEEDBACK=

# Point at DynamoDB Local instead of AWS, e.g. http://localhost:8000.  Leave unset for AWS.
DYNAMO_ENDPOINT=
